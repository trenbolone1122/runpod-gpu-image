#!/bin/bash
# chrome-gpu [chrome args...]
# Headless Google Chrome with WebGL/WebGPU on the NVIDIA GPU through ANGLE over Vulkan. No X server
# needed. Flag set verified on Runpod pods (renderer reads "ANGLE (NVIDIA, Vulkan 1.4 (NVIDIA RTX ...))").
# Check:  chrome-gpu --dump-dom 'data:text/html,<script>...</script>'  or run gpu-smoke.
# Add --disable-dev-shm-usage if Chrome crashes on a host with a small /dev/shm.
. /etc/profile.d/gpu-tools.sh 2>/dev/null
exec google-chrome --headless=new --no-sandbox \
  --enable-unsafe-webgpu --enable-features=Vulkan,WebGPU --use-angle=vulkan --use-vulkan \
  --disable-vulkan-surface --ignore-gpu-blocklist --enable-gpu-rasterization "$@"
