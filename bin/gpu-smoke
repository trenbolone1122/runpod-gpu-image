#!/bin/bash
# gpu-smoke: proves the baked toolchain works on this pod's GPU. Prints PASS/FAIL per check,
# exits 1 if anything failed. Safe to run any time; takes about a minute (Chrome and Blender start once each).
[ -f /etc/profile.d/gpu-tools.sh ] && . /etc/profile.d/gpu-tools.sh
fail=0
ok()  { echo "PASS $*"; }
bad() { echo "FAIL $*"; fail=1; }
check() { local name="$1"; shift; local out; out=$("$@" 2>&1) && ok "$name: $(echo "$out" | head -1 | cut -c1-110)" || bad "$name: $(echo "$out" | tail -1 | cut -c1-160)"; }

check "gpu" nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
check "cuda runtime" python -c 'import torch; print("torch", torch.__version__, "cuda", torch.version.cuda, "available", torch.cuda.is_available())'
check "node" node -v
check "playwright-core" playwright-core --version
check "blender" blender --version
check "blender optix/cuda devices" blender -b --python-expr 'import bpy; p=bpy.context.preferences.addons["cycles"].preferences; [p.get_devices_for_type(t) for t in ("OPTIX","CUDA")]; d=[(x.name,x.type) for x in p.devices if x.type in ("OPTIX","CUDA")]; assert d, "no OPTIX/CUDA device"; print(d)'
check "ffmpeg" ffmpeg -hide_banner -version
check "nvenc encode" bash -c 'ffmpeg -hide_banner -loglevel error -f lavfi -i testsrc=duration=1:size=640x360:rate=30 -c:v h264_nvenc -y /tmp/gpu-smoke-nvenc.mp4 && echo ok && rm -f /tmp/gpu-smoke-nvenc.mp4'
check "vulkan nvidia" bash -c 'vulkaninfo --summary 2>/dev/null | grep -m1 deviceName'
check "chrome" google-chrome --version
check "chrome gpu (ANGLE/Vulkan)" bash -c 'timeout 90 xvfb-run -a chrome-gpu --dump-dom chrome://gpu 2>/dev/null | grep -o "WebGL: Hardware accelerated\|WebGL: Software only\|Vulkan: Enabled\|Vulkan: Disabled" | sort -u | tr "\n" " "'
check "hf cli" hf --help
check "uv" uv --version
[ $fail -eq 0 ] && echo "GPU-SMOKE OK" || echo "GPU-SMOKE FAILED"
exit $fail
